# Copy this file to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: time of day to run the daily backlink build (24h HH:MM, default 09:00)
DAILY_RUN_TIME=09:00

# Optional: directory where markdown reports are saved (default: reports/)
REPORTS_DIR=reports

# Optional: path to the SQLite tracking database (default: backlinks.db)
TRACKER_DB=backlinks.db
